# Pixo has no public hostname. Slack events, interactivity, slash commands and
# shortcuts arrive over Socket Mode, so both tokens are required at startup and
# no signing secret or Request URL is needed.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with the connections:write scope.
SLACK_APP_TOKEN=

# In-cluster HTTP server (/api/external/*, /webhooks/*, /healthz). apps/server
# and apps/internal-dashboard reach it at
# http://pixl-pixorpheus.ysws-pixl.svc.cluster.local:3000.
PORT=3000
# Shared with apps/server and apps/internal-dashboard. Unset = every
# /api/external/* route answers 503.
EXTERNAL_API_KEY=
PIXO_DM_DAILY_LIMIT=1000

# See README.md "Environment Variables" for the rest (channels, AI, webhooks).
