# Pixl Dashboard (pixl.hackclub.com). Every value is a secret: set them as
# secret env vars on the deployment, never commit real values.
#
# apps/server's URL is not configurable here on purpose: it comes from
# packages/config/pixl.json (urls.server) via app/_generated/config.ts.

# Must match apps/server's JWT_SECRET exactly. Sessions are verified locally
# against it on every request.
JWT_SECRET=

# Sent as x-pixl-service-key on the server-to-server POST /auth/exchange.
# Must match SERVICE_KEY_PIXL_DASHBOARD on apps/server.
SERVICE_KEY_PIXL_DASHBOARD=

# Stable key for Server Action closure encryption, identical on every
# instance (generate once: openssl rand -base64 32).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
