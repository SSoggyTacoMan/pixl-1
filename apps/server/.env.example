DATABASE_URL=

JWT_SECRET=change-this-to-a-long-random-string

PII_ENCRYPTION_KEY=

HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_REDIRECT_URI=https://server.pixl.hackclub.com/auth/hackclub/callback

PORT=3000

# Per-caller service keys, sent as the x-pixl-service-key header. Each must be
# a long random value (32+ chars, e.g. `openssl rand -base64 48`); anything
# shorter is treated as unset. No key is shared between callers.
# Pixl Dashboard backend: POST /auth/exchange only.
SERVICE_KEY_PIXL_DASHBOARD=
# Internal Dashboard: /api/admin/*.
SERVICE_KEY_INTERNAL_DASHBOARD=
# Pixo: only the /api/admin/* routes in PIXO_ADMIN_ROUTES (none today).
SERVICE_KEY_PIXO=

# Pixorpheus services (Slack DM proxy and #pixl channel enrollment).
# PIXORPHEUS_URL defaults to Pixo's in-cluster address
# (http://pixl-pixorpheus.ysws-pixl.svc.cluster.local:3000) and EXTERNAL_DM_URL
# to that + /api/external/dm. Leave both blank on Orchard.
EXTERNAL_API_KEY=
EXTERNAL_DM_URL=
PIXORPHEUS_URL=

# Same bot as apps/dashboard's SLACK_BOT_TOKEN. Used to ping REPORT_SLACK_CHANNEL
# when a new player report comes in (src/reports.ts postReportToSlack). Both must
# be set or the alert silently no-ops.
SLACK_BOT_TOKEN=
REPORT_SLACK_CHANNEL=

# Also used by src/shipNotify.ts postShipToSlack, which posts a rich preview
# (title/image/description/hours/author) whenever a project ships or re-ships.
# Optional , defaults to the team's ship-alerts channel if unset. Requires
# SLACK_BOT_TOKEN above; silently no-ops without it.
SHIP_SLACK_CHANNEL=


OPENROUTER_API_KEY=

# Little Guy relay (desktop pet notifications, src/littleGuy.ts). Project
# notifications are forwarded only when both are set; the key must match
# PIXL_API_KEY on the relay.
LITTLE_GUY_URL=
LITTLE_GUY_API_KEY=
